{
  "name": "openfront-replay-coach",
  "version": "2.2.27",
  "private": true,
  "description": "OpenFront Replay Coach — Windows Desktop und Android-App",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:engine && npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:engine && tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:engine": "node scripts/build-engines.mjs",
    "build:web": "npm run build:engine && tsc --noEmit && vite build",
    "preview:web": "vite preview",
    "test:phase-survival": "node --test scripts/phase-survival.test.mjs",
    "test:coach": "node --import ./vendor/OpenFrontIO/node_modules/tsx/dist/loader.mjs --test scripts/phase-survival.test.mjs scripts/pro-coach-algorithm.test.mjs scripts/game-record-shape.test.mjs scripts/replay-compatibility.test.mjs scripts/public-replay-compatibility.test.mjs scripts/longitudinal-coach.test.mjs scripts/batch-analysis-runner.test.mjs",
    "validate:engine-pin": "node scripts/validate-engine-pin.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/browser": "8.0.5",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "@capacitor/cli": "8.6.0",
    "@capacitor/assets": "4.0.0"
  },
  "build": {
    "appId": "de.openfront.replaycoach",
    "productName": "OpenFront Replay Coach",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "vendor/OpenFrontIO/LICENSE",
        "to": "licenses/OpenFrontIO-AGPL-3.0.txt"
      }
    ],
    "extraFiles": [
      {
        "from": "START_HERE.txt",
        "to": "START_HERE.txt"
      }
    ]
  },
  "overrides": {
    "@babel/traverse": "7.29.13"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
